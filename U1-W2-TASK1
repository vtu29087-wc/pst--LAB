class Solution {
    // Approach 1: Basic O(n) Space Solution
    public int[] buildArray(int[] nums) {
        int n = nums.length;
        int[] ans = new int[n];
        for (int i = 0; i < n; i++) {
            ans[i] = nums[nums[i]];
        }
        return ans;
    }

    // Approach 2: Optimal O(1) Space Solution (Modulus Trick)
    public int[] buildArrayInPlace(int[] nums) {
        int n = nums.length;
        
        // Encode both original and new values into nums[i]:
        // nums[i] = original_value + n * (new_value % n)
        for (int i = 0; i < n; i++) {
            nums[i] = nums[i] + n * (nums[nums[i]] % n);
        }
        
        // Extract the new value by integer division by n
        for (int i = 0; i < n; i++) {
            nums[i] = nums[i] / n;
        }
        
        return nums;
    }
}
